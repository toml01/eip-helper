{
  // Extends WXT's generated config, which supplies the DOM/ESNext libs, the
  // path aliases, and -- via .wxt/wxt.d.ts -- the `chrome` types and the
  // defineBackground/defineContentScript globals. Overriding `include` or
  // `types` here drops those, so neither is set.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true
  }
}
